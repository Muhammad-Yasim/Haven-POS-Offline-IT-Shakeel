{
  "name": "haven-pos",
  "productName": "Haven POS",
  "description": "Offline Point of Sale system for Haven",
  "author": "Haven POS",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build --watch & electron .",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder",
    "electron:pack": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.1"
  },
  "build": {
    "appId": "com.havenpos.app",
    "productName": "Haven POS",
    "copyright": "Copyright © 2024 Haven POS",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "buildResources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Haven POS",
      "artifactName": "Haven POS Setup ${version}.exe"
    },
    "asar": true,
    "asarUnpack": []
  }
}
